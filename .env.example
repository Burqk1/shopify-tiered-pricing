# Shopify App
SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret

# Database (Prisma Postgres)
DATABASE_URL="postgresql://user:password@your-prisma-postgres-url:5432/database?sslmode=require"

# App URL
SHOPIFY_APP_URL=https://your-app-url.com

# Cron (required for /api/cron/analytics-sync; the endpoint refuses to run without it)
CRON_SECRET=

# Environment
NODE_ENV=development
